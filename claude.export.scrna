          +bool)                                                         
      832 +    axes[2].scatter(u1[~is_doublet], u2[~is_doublet], s=1.5, a
          +lpha=0.3,                                                     
      833 +                    color=COLOR_MUTED, label="singlet", raster
          +ized=True)                                                    
      834 +    axes[2].scatter(u1[is_doublet], u2[is_doublet], s=3, alpha
          +=0.8,                                                         
      835 +                    color=COLOR_WARN, label="doublet", rasteri
          +zed=True)                                                     
      836 +    axes[2].set_title("UMAP: predicted doublets", fontweight="
          +bold", fontsize=9)                                            
