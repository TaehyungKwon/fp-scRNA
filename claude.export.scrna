      785 +def make_doublet_summary(adata: ad.AnnData, viz_dir: Path, tab
          +les_dir: Path) -> None:                                       
      786 +    """                                                       
      787 +    02c_doublet_summary.pdf (2-column grid) + doublet_summary.
          +tsv                                                           
      788 +    Panel 1: doublet_score distribution per sample (boxplot, o
          +utliers only --                                               
      789 +             same style as 02b_qc_metrics_boxplot.pdf).       
      790 +    Panel 2: doublet fraction (%) per sample.                 
      791 +    Panel 3: UMAP colored by predicted_doublet (singlet vs dou
          +blet).                                                        
      792 +    Doublets are flagged only by default (REMOVE_DOUBLETS=fals
          +e, see run_qc())                                              
      793 +    -- inspect this figure before deciding whether to enable r
          +emoval.                                                       
      794 +    """                                                       
      795 +    if "doublet_score" not in adata.obs.columns:              
      796 +        log.info("[VIZ] doublet_score not available (no scDblF
          +inder/scrublet ran) "                                         
      797 +                 "— skipping 02c_doublet_summary")            
      798 +        return                                                
      799 +                                                              
      800 +    samples = sorted(adata.obs["sample"].unique())            
      801 +    fig, axes = grid_figure(3, row_h_in=3.2)                  
      802 +                                                              
      803 +    # Panel 1 -- doublet_score distribution per sample        
      804 +    flier_style = dict(marker="o", markersize=1.5, markeredgew
          +idth=0,                                                       
      805 +                       markerfacecolor=COLOR_WARN, alpha=0.5) 
      806 +    scores_by_sample = [adata.obs.loc[adata.obs["sample"] == s
          +, "doublet_score"].dropna().values                            
      807 +                       for s in samples]                      
      808 +    bp = axes[0].boxplot(scores_by_sample, tick_labels=samples
          +, patch_artist=True,                                          
      809 +                         widths=0.55, flierprops=flier_style) 
      810 +    for patch in bp["boxes"]:                                 
      811 +        patch.set_facecolor(COLOR_MID)                        
      812 +    axes[0].set_xticklabels(samples, rotation=35, ha="right") 
      813 +    axes[0].set_ylabel("doublet_score")                       
      814 +    axes[0].set_title("Doublet score\nper sample", fontweight=
          +"bold")                                                       
      815 +    axes[0].spines[["top", "right"]].set_visible(False)       
      816 +                                                              
      817 +    # Panel 2 -- doublet fraction per sample                  
      818 +    frac = (adata.obs.groupby("sample")["predicted_doublet"].m
          +ean() * 100).reindex(samples)                                 
      819 +    axes[1].bar(samples, frac.values, color=COLOR_WARN, edgeco
          +lor="white")                                                  
      820 +    axes[1].set_ylabel("% predicted doublets")                
      821 +    axes[1].set_xticks(range(len(samples)))                   
      822 +    axes[1].set_xticklabels(samples, rotation=35, ha="right") 
      823 +    axes[1].set_title("Doublet fraction\nper sample", fontweig
          +ht="bold")                                                    
      824 +    axes[1].spines[["top", "right"]].set_visible(False)       
      825 +    for i, v in enumerate(frac.values):                       
      826 +        axes[1].text(i, v + max(frac.values) * 0.03, f"{v:.1f}
          +%", ha="center", va="bottom", fontsize=7)                     
      827 +                                                              
      828 +    # Panel 3 -- UMAP colored by predicted_doublet            
      829 +    umap = adata.obsm["X_umap"]                               
      830 +    u1, u2 = umap[:, 0], umap[:, 1]                           
